{
  "name": "@gpellicciotta/hinolugi-support.js",
  "version": "0.82.1-pre",
  "description": "General-purpose Javascript support code, both for client and server-side use",
  "type": "module",
  "exports": {
    "./*.mjs": "./js/*.mjs"
  },
  "files": [
    "js",
    "css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --test",
    "format": "prettier --write \"js/**/*.mjs\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"js/**/*.mjs\" \"tests/**/*.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpellicciotta/hinolugi-support.js.git"
  },
  "author": "Giovanni Pellicciotta",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gpellicciotta/hinolugi-support.js/issues"
  },
  "homepage": "https://github.com/gpellicciotta/hinolugi-support.js#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
